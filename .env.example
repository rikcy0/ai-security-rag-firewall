# App
APP_NAME=AI Security RAG Firewall
APP_ENV=development
DEBUG=true

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rag_firewall

# Auth
SECRET_KEY=replace-this-with-a-secure-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60

# AI Provider
OPENAI_API_KEY=your-api-key-here

# Embeddings
EMBEDDING_MODEL=text-embedding-3-small

# Security
PROMPT_INJECTION_BLOCK_THRESHOLD=50
LOG_SECURITY_EVENTS=true