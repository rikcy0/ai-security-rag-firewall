# App
RAG_FIREWALL_APP_NAME=AI Security RAG Firewall
RAG_FIREWALL_APP_ENV=development
RAG_FIREWALL_DEBUG=true

# Backend
RAG_FIREWALL_BACKEND_HOST=0.0.0.0
RAG_FIREWALL_BACKEND_PORT=8000

# Database
RAG_FIREWALL_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/rag_firewall

# Auth
RAG_FIREWALL_SECRET_KEY=replace-with-output-of-openssl-rand-hex-32
RAG_FIREWALL_ACCESS_TOKEN_EXPIRE_MINUTES=60

# AI Provider
RAG_FIREWALL_OPENAI_API_KEY=your-api-key-here

# Embeddings
RAG_FIREWALL_EMBEDDING_MODEL=text-embedding-3-small

# Security
RAG_FIREWALL_PROMPT_INJECTION_BLOCK_THRESHOLD=50
RAG_FIREWALL_LOG_SECURITY_EVENTS=true